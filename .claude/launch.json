{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cripta",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123"
      ],
      "port": 8123
    },
    {
      "name": "editor",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const r=process.cwd();const t={'.html':'text/html; charset=utf-8','.js':'text/javascript','.mapa':'text/plain; charset=utf-8','.png':'image/png','.jpg':'image/jpeg','.jpeg':'image/jpeg','.md':'text/plain; charset=utf-8'};h.createServer(function(q,s){const a=p.join(r,decodeURIComponent(q.url.split('?')[0]));if(a.indexOf(r)!==0){s.writeHead(403);return s.end();}f.readFile(a,function(e,d){if(e){s.writeHead(404);return s.end('404');}s.writeHead(200,{'Content-Type':t[p.extname(a)]||'application/octet-stream','Cache-Control':'no-store'});s.end(d);});}).listen(8124,'127.0.0.1');"
      ],
      "port": 8124
    }
  ]
}
